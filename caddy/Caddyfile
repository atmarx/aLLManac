# The aLLManac edge — one hostname per surface, TLS for all three.
#
# TLS modes (EDGE_TLS in .env):
#   internal    Caddy's own local CA — LAN/dev default; browsers warn once
#   you@email   real ACME.  Public box: works as-is (HTTP-01).  RFC 1918 box:
#               also uncomment the acme_dns block below (DNS-01 — see README)
{
    email {$ACME_EMAIL:ops@example.edu}

    # Clients hitting a bare IP send no SNI, and Caddy picks certs by SNI —
    # name the IP site here or IP connections die with a TLS internal error.
    # (LAN HTTPS mode: set EDGE_DEFAULT_SNI=<box-ip> in .env.)
    default_sni {$EDGE_DEFAULT_SNI:localhost}

    # DNS-01 against a delegated Azure zone — for boxes a public CA can't
    # reach on port 80.  Credentials come from .env; the role should be
    # TXT-only scoped.  (The full pattern: root-cellar's DNS delegation guide.)
    # acme_dns azure {
    #     tenant_id           {env.AZURE_TENANT_ID}
    #     client_id           {env.AZURE_CLIENT_ID}
    #     client_secret       {env.AZURE_CLIENT_SECRET}
    #     subscription_id     {env.AZURE_SUBSCRIPTION_ID}
    #     resource_group_name rg-almanac-dns
    # }

    # Prove issuance on the LE staging CA first (no rate limits), then remove:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ---- The upgrade page (docs/upgrade-page.md) ---------------------------------
# Snippets, defined before every site that imports them — the rendered course
# vhosts in fleet/caddy/ included, which is why they live here and not there.
#
# upgrade_page — the PASSIVE layer, on every proxied site.  A 502/503/504 that
# CADDY raises (the upstream refused, didn't resolve, or timed out) becomes
# the page for a browser and a JSON 503 for anything else.  It does not touch
# a 5xx the upstream ANSWERS with — that is the service's own reply, and the
# gateway's error JSON in particular must reach the program that asked.
# Measured on 2.11.4: design-walls.md, "The upgrade page".
#
# It also serves /_status.json, which `just deploy` writes into status/ (the
# edge mounts it read-only at /srv/status), so the page's poll is same-origin
# on every host it can appear on.  No deploy has run yet: {"state": "idle"}.
(upgrade_page) {
    handle /_status.json {
        header Cache-Control no-store
        @upgrade_no_status not file {
            root /srv/status
            try_files /status.json
        }
        header @upgrade_no_status Content-Type application/json
        respond @upgrade_no_status `{"state": "idle"}` 200
        root * /srv/status
        rewrite * /status.json
        file_server
    }
    handle_errors 502 503 504 {
        @upgrade_browser header Accept *text/html*
        handle @upgrade_browser {
            import upgrade_html
        }
        handle {
            import upgrade_json
        }
    }
}

# not_on_roster — the page for a sign-in a COURSE turned away
# (caddy/notenrolled/index.html).  A course's chat requires the `member` role
# its roster grants (OPENID_REQUIRED_ROLE, registrar/render.py).  Without it
# the chat engine redirects the browser to /login?redirect=false&error=auth_failed
# and shows "Authentication failed.  Please check your login method and try
# again", which tells an un-enrolled student to go and fight their password.
# That redirect is a full navigation, so the edge sees the GET and answers it.
# Measured on the pinned 0.8.8 image, 2026-11-11: packages/api
# src/oauth/callback.ts, redirectToAuthFailure.
#
# Course hosts only.  On the chat host the same address means the sign-in
# itself failed, there is no roster to be missing from, and the engine's own
# page stays.  A browser navigation only, and never a request carrying
# X-Almanac-Bypass, the same way an operator looks behind the upgrade page.
# 403, not 200: the person was refused, and a probe should see that.
# X-Almanac-Page says which of the edge's pages answered.
#
# The edge cannot see WHY a sign-in failed; every cause lands on this
# address.  The page says "nearly always" for that reason.
(not_on_roster) {
    @not_on_roster {
        path /login
        query error=auth_failed
        method GET HEAD
        header Accept *text/html*
        not host {$CHAT_HOST:chat.localhost}
        not header X-Almanac-Bypass *
    }
    handle @not_on_roster {
        header {
            Cache-Control no-store
            X-Almanac-Page not-on-roster
        }
        root * /etc/caddy/notenrolled
        rewrite * /index.html
        # Fills {{env "PLATFORM_NAME"}}, {{env "CHAT_HOST"}} and {{.Host}}.
        templates
        file_server {
            status 403
        }
    }
}

# upgrade_flag — the ACTIVE layer, on the chat host and every course host.
# While status/upgrading exists (`just deploy` holds it from `up` through
# `oidc-settle`), a browser navigation gets the page on purpose.  Never
# /_status.json or /help/, never anything but a GET/HEAD — so a form post
# and every admin-config write still meet what they would meet without it —
# and never a request carrying X-Almanac-Bypass, which is how an operator or
# a probe looks behind the page.  The bypass is not a secret: what it
# reaches is exactly what would be there with no flag.
(upgrade_flag) {
    @upgrade_flag {
        file {
            root /srv/status
            try_files /upgrading
        }
        method GET HEAD
        header Accept *text/html*
        not header X-Almanac-Bypass *
        not path /_status.json /help /help/*
    }
    handle @upgrade_flag {
        import upgrade_html
    }
    # Rides here because every course's rendered vhost already imports this
    # snippet, so the page reaches each course on a deploy with no re-render.
    # After the flag's own handle on purpose: during an upgrade, the upgrade
    # page wins.  When registrar/render.py next changes the vhost template,
    # move this import there and delete it here in the SAME commit; imported
    # twice in one site, the matcher is defined twice and the edge won't load.
    import not_on_roster
}

# The two bodies.  503, never 200 — monitoring must see an outage as one —
# with Retry-After, and no-store so no browser or proxy keeps the page in
# place of the chat.  X-Almanac-Page is how the page's own script asks "would
# a plain navigation still get me?" — when the answer is no, it reloads.
(upgrade_html) {
    header {
        Retry-After 30
        Cache-Control no-store
        X-Almanac-Page upgrade
    }
    root * /etc/caddy/upgrade
    rewrite * /index.html
    # Fills {{env "PLATFORM_NAME"}} and {{env "CHAT_HOST"}}, and inlines lines.txt.
    templates
    file_server {
        status 503
    }
}
(upgrade_json) {
    header {
        Retry-After 30
        Cache-Control no-store
        X-Almanac-Page upgrade
        Content-Type application/json
    }
    respond `{"error": "This service is restarting.  Try again in a minute.", "retry_after": 30}` 503
}

# The chat — where everyone lives
#
# X-Tenant-Id is stripped because our LibreChat pin TRUSTS it: on /oauth and
# /api/auth, any well-formed client-supplied value scopes every query in the
# request to that tenant, strict mode or not.  We run single-tenant and set
# none of the tenancy vars, so the only correct value is no value.  See
# docs/design-walls.md, "The tenancy machinery is already in our pin."
{$CHAT_HOST:chat.localhost} {
    tls {$EDGE_TLS:internal}

    # The upgrade page: the passive layer (and /_status.json), then the flag.
    # Its handle_errors names 502 503 504, so it sits beside the /help/ 404
    # handler below rather than replacing it.
    import upgrade_page
    import upgrade_flag

    # The live SBOM — sbom/latest/ as `just build` left it, for the infosec
    # scanner's URL list.  Bearer-gated with SBOM_TOKEN (generated by `just
    # secrets`).  The second clause is the fail-closed: a box whose .env has
    # no token yet gets a matcher that can never be true, not one that any
    # "Bearer " satisfies.  The mount is sbom/ (the parent) because latest/
    # is replaced by rename on every build — the same inode rule as every
    # other bind here.
    @sbom path /sbom /sbom/*
    route @sbom {
        @scanner expression `{header.Authorization} == "Bearer {$SBOM_TOKEN}" && "{$SBOM_TOKEN}" != ""`
        handle @scanner {
            uri strip_prefix /sbom
            root * /srv/sbom/latest
            file_server browse
        }
        respond 401
    }

    # The help site — `just docs-build` output, which every box builds and
    # mounts at /srv/docs.  Tracked, not a site override: there is no box
    # where serving it is wrong, and while the route lived only in one box's
    # site/ every other install built the pages, mounted them, and handed
    # /help/ to LibreChat, which answers any path with a blank chat shell.
    # mkdocs is built for this prefix (site_url in mkdocs.yml), so its
    # 404.html and assets already say /help/.
    redir /help /help/ 308
    handle_path /help/* {
        root * /srv/docs
        file_server
    }
    # A missing help page gets mkdocs' own 404.html, still with status 404.
    # file_server alone answers a bare 404; the page only shows up through an
    # error route.  Scoped to /help/ — everything else here is LibreChat's,
    # and its 404s are its own responses, not Caddy errors.
    handle_errors 404 {
        @help path /help/*
        handle @help {
            root * /srv/docs
            rewrite * /404.html
            file_server
        }
    }

    # An owner's export of their own data (registrar-spec.md, "Your own
    # data") — the ONE registrar path the edge exposes.  The token in the
    # path is the access control and dies in 24h; /mcp and /health stay
    # loopback-only because nothing else here routes to the registrar.
    handle /exports/* {
        reverse_proxy registrar:8080
    }

    reverse_proxy librechat:3080 {
        header_up -X-Tenant-Id
    }
}

# The front door — Keycloak (set KC_PROXY_HEADERS=xforwarded in compose.yml)
{$AUTH_HOST:auth.localhost} {
    tls {$EDGE_TLS:internal}
    # Passive only: sign-in is never behind the flag.  A browser mid-login
    # while Keycloak restarts gets the page, not a bare 502.
    import upgrade_page
    reverse_proxy keycloak:8080
}

# The ledger — LiteLLM admin UI + key API (admin-facing; consider IP-allowlisting)
{$GATEWAY_HOST:gateway.localhost} {
    tls {$EDGE_TLS:internal}
    # Passive only.  Programs (opencode, a course's agents) get the JSON 503.
    import upgrade_page
    reverse_proxy litellm:4000
}

# The policy address — `/terms` and `/privacy` at a short, stable name (an app
# registration asks for both; Globus's was the first).  One copy of each page
# exists, on the help site (apex/terms.md, apex/privacy.md), so this host only
# redirects there, and anything else goes to the chat.  302, not 308: if the
# pages are ever served here directly, no browser has cached a permanent answer.
#
# OPT-IN, because a named site is a certificate order.  Unset, POLICY_HOST is
# a .localhost name on the internal CA, which orders nothing.  Its TLS is its
# OWN setting, not EDGE_TLS: measured on 2.11.4, `tls you@email` puts explicit
# ACME issuers on a .localhost name too, so a box on real ACME would retry an
# order for the default name forever.  An operator sets POLICY_HOST (usually
# the bare ALMANAC_DOMAIN, which a *.<domain> wildcard does not cover) once
# its DNS points here, and POLICY_TLS to what EDGE_TLS says.
{$POLICY_HOST:policy.localhost} {
    tls {$POLICY_TLS:internal}
    @terms path /terms /terms/
    @privacy path /privacy /privacy/
    handle @terms {
        redir https://{$CHAT_HOST:chat.localhost}/help/terms/ 302
    }
    handle @privacy {
        redir https://{$CHAT_HOST:chat.localhost}/help/privacy/ 302
    }
    handle {
        redir https://{$CHAT_HOST:chat.localhost}/ 302
    }
}

# The course fleet — one vhost pair per course, RENDERED by the registrar
# into fleet/caddy/ (mounted here read-only).  `just course` finishes with a
# graceful reload; the _stub file keeps the glob non-empty on fresh boxes.
# Real-ACME deployments: wildcard DNS (*.{ALMANAC_DOMAIN}) + the DNS-01
# azure block above = one wildcard cert covers every course.
#
# A SIBLING of /etc/caddy, not a child: this directory is a second bind mount,
# and docker cannot create a mountpoint inside the read-only one that holds
# this file.  See the comment on the edge's volumes in compose.yml.
import /etc/caddy-fleet/*.caddy

# The catch-all — a hostname under this domain that matches no course.
#
# Last, because a Caddyfile site is chosen by SPECIFICITY, not by order: every
# named site above and every rendered course vhost beats this one.  What
# reaches here is what reached nothing else, and until now that was a closed
# connection and a white screen.
#
# DELIBERATELY ADDRESSED BY PORT, NOT BY `*.{$ALMANAC_DOMAIN}`.  A wildcard
# SITE is a wildcard NAME in the automation policy, and from Caddy 2.10 on an
# automated wildcard is used for individual subdomains — Caddy stops obtaining
# per-subdomain certificates unless told to with `force_automate`
# (docs/tls.md).  So on a box doing HTTP-01, which cannot get a wildcard at
# all, declaring one here would quietly cancel per-course issuance and take
# the fleet's TLS down to fix a 404.  `:443` names nothing, automates nothing,
# and matches only what no site claimed.
#
# The certificate is therefore whatever the box already holds for that SNI: a
# real wildcard serves this cleanly, and a box without one shows the browser's
# name-mismatch warning first.  That is the same warning that hostname would
# have produced anyway, and it is not this route's to fix.
#
# Addressed on 443 only: a bare `:80` site here would sit under the ACME
# HTTP-01 path on every box that uses it.  It costs nothing — measured, Caddy
# 2.11.4: auto_https already 308s http://<unknown-slug>/ to https, so the
# plain-http visitor lands here too.
#
# Measured alongside it, because this block could only be wrong in ways that
# are invisible: the named sites above still beat it (a real host still
# reaches its proxy, not this page), deep paths on an unknown host still get
# it, and the automation policy still lists exactly chat/auth/gateway — no
# wildcard, nothing new.
:443 {
    tls {$EDGE_TLS:internal}

    root * /etc/caddy/nocourse
    rewrite * /index.html
    # Fills {{env "CHAT_HOST"}} — an absolute help link, because a relative
    # one resolves back to this same catch-all and loops.
    templates
    # 404, not 200: the address really doesn't exist, and a crawler or a
    # link-checker should be told so.  The page is the body of the 404.
    file_server {
        status 404
    }
}
