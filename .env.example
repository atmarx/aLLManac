# ============================================================================
# The aLLManac — copy to .env and edit:   just setup     (or: cp .env.example .env)
# `just setup` also generates every "change-me" secret below with openssl.
# .env is gitignored.  Everything left as change-me MUST be set before first up.
# ============================================================================

# ---- Host / profiles --------------------------------------------------------
# The address people browse the stack at.  Single-box LAN: the machine's IP or
# DNS name (NOT localhost, so the browser AND containers agree on where
# Keycloak lives).  e.g.  ALMANAC_HOST=10.10.1.15  or  ALMANAC_HOST=gpu01.lab.edu
ALMANAC_HOST=localhost

# Which optional services to run (comma-separated):
#   gpu   = local vLLM on this box's GPU(s)
#   edge  = the Caddy front door (TLS + hostnames) for real deployments
# COMPOSE_PROFILES=gpu
# COMPOSE_PROFILES=edge
COMPOSE_PROFILES=

# Published ports (change if the box already uses them):
CHAT_PORT=3080
GATEWAY_PORT=4000
AUTH_PORT=8080
VLLM_PORT=8000

# ---- Images (PINNED — bump deliberately: edit, deploy, verify, commit) ------
# LibreChat: release tag, digest-verified against the build we deployed.
LIBRECHAT_IMAGE=ghcr.io/danny-avila/librechat:v0.8.7
# LiteLLM's stable channel is a moving tag, so pin its digest (= LiteLLM 1.91.1):
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable@sha256:47afa74b495c802317712e5b8c8a65e7ca30c96636e9b618a5f8130eec72a8ee
# The RAG API only publishes a dev channel — pin the digest we tested:
RAG_API_IMAGE=ghcr.io/danny-avila/librechat-rag-api-dev:latest@sha256:c3e1a05bdd576b5000fa0e8a84a476e9858fa9219b2b5d78432ddce12c9fcf23
# vLLM: release tag (gpu profile only):
VLLM_IMAGE=vllm/vllm-openai:v0.24.0

# ---- Inference: where the tokens come from ----------------------------------
# ANY OpenAI-compatible endpoint.  The model name LiteLLM routes to must match
# what this endpoint serves — see litellm/config.yaml (model: openai/<name>).
#
#   Local GPU (profile gpu):     INFERENCE_BASE_URL=http://vllm:8000/v1
#   A campus inference box:      INFERENCE_BASE_URL=http://gpu01.lab.edu:11434/v1   (Ollama)
#                                INFERENCE_BASE_URL=http://gpu02.lab.edu:8000/v1    (remote vLLM)
#   Cloud (last resort):         INFERENCE_BASE_URL=https://api.openai.com/v1
#                                INFERENCE_API_KEY=sk-your-real-cloud-key
INFERENCE_BASE_URL=http://vllm:8000/v1
INFERENCE_API_KEY=dummy-local-endpoints-ignore-this
# "openai/" + the name your endpoint serves: VLLM_SERVED_NAME for the gpu
# profile, or the Ollama tag (e.g. openai/qwen3:30b-a3b):
INFERENCE_MODEL=openai/qwen2.5

# ---- Local model (vLLM, profile gpu only) -----------------------------------
# vLLM wants SAFETENSORS (GGUF is Ollama's format).  On H200/GH200 prefer an
# FP8 safetensors checkpoint.  Ungated default => runs cold with no HF token:
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# This short name is what vLLM serves AND what LiteLLM routes to — it MUST
# match litellm/config.yaml (model: openai/<this name>):
VLLM_SERVED_NAME=qwen2.5
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEM_UTIL=0.90
VLLM_TP_SIZE=1          # tensor-parallel size = number of GPUs for big models
GPU_COUNT=1             # GPUs to reserve: an integer or "all"
HF_TOKEN=               # only needed for GATED models (e.g. Llama)

# ---- LiteLLM gateway (the ledger) --------------------------------------------
LITELLM_MASTER_KEY=sk-change-me-master      # admin key; must start with "sk-"
LITELLM_DB_PASSWORD=change-me-litellm-db

# ---- LibreChat ---------------------------------------------------------------
ALLOW_EMAIL_LOGIN=false       # native login OFF — Keycloak is the front door
ALLOW_REGISTRATION=false      # accounts come from the IdP, not self-signup
ALLOW_SOCIAL_LOGIN=true       # the "Sign in with SSO" button
# Secrets — `just setup` generates these.  (Manual: openssl rand -hex 32;
# CREDS_IV: openssl rand -hex 16.)
JWT_SECRET=change-me-jwt-hex
JWT_REFRESH_SECRET=change-me-refresh-hex
# !! CREDS_KEY/CREDS_IV encrypt every user's saved API key AT REST in Mongo.
# PIN THEM ONCE AND NEVER CHANGE THEM on a live instance: rotating them (or
# letting a setup re-randomize them) orphans every stored key — users get
# "invalid key provided" until they re-paste.  `just setup` will NEVER touch a
# value that is already set.  (This exact failure bit a prior deployment.)
CREDS_KEY=change-me-64-hex-chars
CREDS_IV=change-me-32-hex-chars
MEILI_MASTER_KEY=change-me-meili
RAG_DB_PASSWORD=change-me-rag-db

# ---- OIDC: LibreChat -> Keycloak ---------------------------------------------
# The host in OPENID_ISSUER must match how the BROWSER reaches Keycloak:
#   direct ports:  http://<ALMANAC_HOST>:8080/realms/northwinds
#   edge profile:  https://<AUTH_HOST>/realms/northwinds
# OPENID_CLIENT_SECRET: paste the secret Keycloak generates for the `librechat`
# client on first boot (admin -> Clients -> librechat -> Credentials).
OPENID_ISSUER=http://localhost:8080/realms/northwinds
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=paste-from-keycloak-after-first-boot
OPENID_SESSION_SECRET=change-me-openid-session
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL="Sign in with Northwinds SSO"

# ---- Keycloak ------------------------------------------------------------------
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-kc-admin
KC_DB_PASSWORD=change-me-kc-db
KC_REALM=northwinds
# Behind the edge profile, set the public hostname KC should advertise:
# KC_HOSTNAME=auth.almanac.example.edu
# KC_HOSTNAME_PORT=443

# ---- Edge front door (profile edge only) --------------------------------------
# One hostname per surface; Caddy terminates TLS for all three.
CHAT_HOST=chat.localhost
AUTH_HOST=auth.localhost
GATEWAY_HOST=gateway.localhost
# TLS mode: "internal" = Caddy's own local CA (LAN default, browsers will warn)
#           your@email  = real ACME (needs public reachability, or the DNS-01
#                         azure block in caddy/Caddyfile — see README)
EDGE_TLS=internal
ACME_EMAIL=ops@example.edu
# DNS-01 via delegated Azure zone (only if enabled in caddy/Caddyfile):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# Behind the edge, LibreChat should know its public URL:
# DOMAIN_CLIENT=https://chat.almanac.example.edu
# DOMAIN_SERVER=https://chat.almanac.example.edu

# ---- LAN HTTPS (edge profile, no DNS needed) -----------------------------------
# LibreChat (>= v0.8) requires an HTTPS OIDC issuer — plain http:// logins fail
# with "[openidStrategy] only requests to HTTPS are allowed".  On a LAN with no
# DNS, let the edge's internal CA mint IP certificates instead:
#
#   COMPOSE_PROFILES=edge
#   CHAT_HOST=<box-ip>                 # chat on https://<box-ip>
#   AUTH_HOST=<box-ip>:8443            # keycloak on https://<box-ip>:8443
#   OPENID_ISSUER=https://<box-ip>:8443/realms/northwinds
#   KC_HOSTNAME=https://<box-ip>:8443
#   KC_PROXY_HEADERS=xforwarded
#   DOMAIN_CLIENT=https://<box-ip>
#   DOMAIN_SERVER=https://<box-ip>
#   # Node inside librechat must trust Caddy's internal CA (mounted read-only):
#   NODE_EXTRA_CA_CERTS=/caddy-data/caddy/pki/authorities/local/root.crt
#
# Browsers warn once on the internal CA — accepted posture for LAN/dev.  For
# real certs, use hostnames + real ACME (EDGE_TLS=you@email / DNS-01).
