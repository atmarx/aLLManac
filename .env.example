# ============================================================================
# The aLLManac — copy to .env and edit:   just setup     (or: cp .env.example .env)
# `just setup` also generates every "change-me" secret below with openssl.
# .env is gitignored.  Everything left as change-me MUST be set before first up.
# ============================================================================

# ---- Host / profiles --------------------------------------------------------
# The address people browse the stack at.  Single-box LAN: the machine's IP or
# DNS name (NOT localhost, so the browser AND containers agree on where
# Keycloak lives).  e.g.  ALMANAC_HOST=192.168.1.15  or  ALMANAC_HOST=gpu01.lab.edu
ALMANAC_HOST=localhost

# Which optional services to run (comma-separated):
#   edge       = the Caddy front door (TLS + hostnames) for real deployments
#   workbench  = opencode coding harness (run-on-demand: just workbench <key>;
#                the profile never starts with `just up`)
# Local vLLM is NOT a profile — it's its own stack, and a SITE-local one
# (site/inference/vllm.compose.yml, `just vllm-up`): separate so the model
# stays loaded while this stack deploys, site-local so a box with no GPU
# just doesn't have it.  See site.example/README.md.
# COMPOSE_PROFILES=edge
COMPOSE_PROFILES=

# Where the published ports BIND.  Loopback by default, because chat, the
# gateway, the panel and Keycloak are meant to be reached THROUGH the edge —
# a client that hits their ports directly skips every rule the edge enforces,
# including the X-Tenant-Id strip our LibreChat pin needs (design-walls).
# The edge's own 80/443 always bind everywhere; that's the front door.
# Set 0.0.0.0 for the no-DNS LAN mode at the bottom of this file, where the
# ports ARE the front door — nothing else in here needs it.
PUBLISH_BIND=127.0.0.1

# Published ports (change if the box already uses them):
CHAT_PORT=3080
GATEWAY_PORT=4000
AUTH_PORT=8080
VLLM_PORT=8000
ADMIN_PANEL_PORT=3082
# usage-mcp binds 127.0.0.1 only (it's for `just smoke`, not for the LAN):
USAGE_MCP_PORT=8090

# ---- Channel: which set of image pins this box runs ------------------------
# The pins live in channels/<name>.env, tracked, one file per channel:
#   stable  — what courses run on.  Deployed, walked, committed.
#   latest  — the dev playground: release candidates go here first, get
#             validated on a box nobody teaches on, then move to stable.
# `just` hands the channel file to compose ahead of .env, so a single pin can
# still be overridden here (LIBRECHAT_IMAGE=... below the line wins) — do that
# for a hotfix, not as a way of life.  vLLM's pin stays in the inference
# section: almanac consumes inference, it never ships it.
ALMANAC_CHANNEL=stable
# ---- Inference: where the tokens come from ----------------------------------
# ANY OpenAI-compatible endpoint.  The model name LiteLLM routes to must match
# what this endpoint serves — see litellm/config.yaml (model: openai/<name>).
#
#   site/inference/ on THIS box: INFERENCE_BASE_URL=http://host.docker.internal:8000/v1
#                                (`just vllm-up`; the app compose maps host-gateway)
#   A campus inference box:      INFERENCE_BASE_URL=http://gpu01.lab.edu:11434/v1   (Ollama)
#                                INFERENCE_BASE_URL=http://gpu02.lab.edu:8000/v1    (remote vLLM,
#                                e.g. that box's own site/inference/ stack)
#   Cloud (last resort):         INFERENCE_BASE_URL=https://api.openai.com/v1
#                                INFERENCE_API_KEY=sk-your-real-cloud-key
INFERENCE_BASE_URL=http://host.docker.internal:8000/v1
INFERENCE_API_KEY=dummy-local-endpoints-ignore-this
# "openai/" + the name your endpoint serves: VLLM_SERVED_NAME for the gpu
# profile, or the Ollama tag (e.g. openai/qwen3:30b-a3b):
INFERENCE_MODEL=openai/qwen2.5

# ---- Local model (site/inference/: just vllm-up) -----------------------------
# Ignored entirely if this box doesn't run inference — delete site/inference/
# and point INFERENCE_BASE_URL at whatever does.
# vLLM wants SAFETENSORS (GGUF is Ollama's format).  On H200/GH200 prefer an
# FP8 safetensors checkpoint.  Ungated default => runs cold with no HF token:
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# This short name is what vLLM serves AND what LiteLLM routes to — it MUST
# match litellm/config.yaml (model: openai/<this name>):
VLLM_SERVED_NAME=qwen2.5
# 16k minimum if coding harnesses will use this model — opencode's system
# prompt + tool schemas eat ~8k alone, and small contexts silently break tool
# calling.  Drop to 8192 only for chat-only deployments on tight VRAM:
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.90
VLLM_TP_SIZE=1          # tensor-parallel size = number of GPUs for big models
GPU_COUNT=1             # GPUs to reserve: an integer or "all"
# Only for GATED models (e.g. Llama).  KEEP THE COMMENT ON ITS OWN LINE:
# Compose strips a trailing comment from a NON-empty value and keeps it as the
# value of an empty one, so `HF_TOKEN=   # note` sets the token to "# note" and
# vLLM then sends that as a bearer token and 401s on a PUBLIC model.
HF_TOKEN=
# Tool-calling parser for the model family — hermes fits Qwen 2.5.  Coding
# harnesses (opencode) and LibreChat agent tools NEED tool calling; see
# site.example/inference/vllm.compose.yml for the flags, and
# docs/design-walls.md for why there is no universal parser:
VLLM_TOOL_PARSER=hermes

# ---- LiteLLM gateway (the ledger) --------------------------------------------
LITELLM_MASTER_KEY=sk-change-me-master      # admin key; must start with "sk-"
LITELLM_DB_PASSWORD=change-me-litellm-db

# ---- LibreChat ---------------------------------------------------------------
ALLOW_EMAIL_LOGIN=false       # native login OFF — Keycloak is the front door
ALLOW_REGISTRATION=false      # accounts come from the IdP, not self-signup
ALLOW_SOCIAL_LOGIN=true       # the "Sign in with SSO" button
# Secrets — `just setup` generates these.  (Manual: openssl rand -hex 32;
# CREDS_IV: openssl rand -hex 16.)
JWT_SECRET=change-me-jwt-hex
JWT_REFRESH_SECRET=change-me-refresh-hex
# !! CREDS_KEY/CREDS_IV encrypt every user's saved API key AT REST in Mongo.
# PIN THEM ONCE AND NEVER CHANGE THEM on a live instance: rotating them (or
# letting a setup re-randomize them) orphans every stored key — users get
# "invalid key provided" until they re-paste.  `just setup` will NEVER touch a
# value that is already set.  (This exact failure bit a prior deployment.)
CREDS_KEY=change-me-64-hex-chars
CREDS_IV=change-me-32-hex-chars
MEILI_MASTER_KEY=change-me-meili

# Conversation search.  Set in compose.yml (default true), NOT here — but this
# is the override: SEARCH=false turns the flagship's search off without
# touching a tracked file.  LibreChat gates ALL Meili indexing on this being
# the literal string "true"; unset means the Meili container runs empty while
# still costing ~80MB of RAM, which is what it did until 2026-09-15.
# SEARCH=false
RAG_DB_PASSWORD=change-me-rag-db
# File uploads are rate-limited per user and per IP (defaults 50 and 100, per
# 15 minutes) and a refusal logs a violation against the uploader.  The guide
# corpus is fifty files, so the FIRST `just agents-seed` on a box spends the
# owner's whole budget; after that it only re-uploads what changed.  Raise
# these only if a box genuinely needs a bigger corpus in one pass — it is an
# abuse control.  See docs/design-walls.md, "The file-upload limiter".
# FILE_UPLOAD_USER_MAX=50
# FILE_UPLOAD_IP_MAX=100
# Which gateway model the guide agents run on.  SETTING THIS RE-POINTS EVERY
# EXISTING GUIDE on the next `just agents-seed`; leaving it unset means new
# agents get the default below and existing ones keep whatever they have.
# Name a PRICED model — an unpriced one meters at $0 and vestibule spend
# silently stops being attributed to anybody.
# AGENT_MODEL=almanac-chat

# LiteLLM re-downloads its model cost map at every boot and falls back to a
# bundled backup silently.  The backup is ~1000 models smaller than the live
# one and does not know the current hosted families, so a digest-pinned image
# prices differently depending on whether it reached GitHub at startup.
#   unset  — current cloud prices, boot-time egress, non-deterministic
#   True   — no egress, reproducible, and YOU declare any cloud model's rates
# All-local deployments want True: campus models meter at $0 by design, so the
# map buys nothing and the egress is pure attack surface.
# LITELLM_LOCAL_MODEL_COST_MAP=True

# Where the model roster lives.  False (the default) means litellm/config.yaml
# is the whole list and the admin UI cannot add to it.  True lets the UI write
# models into Postgres — where LiteLLM stores litellm_params ENCRYPTED with the
# master key, so a model added that way is discoverable from neither the repo
# nor the database.  On 2026-09-13 one such model outlived the Ollama tag it
# pointed at and took a vestibule down with a 404 naming a model that appeared
# in no file on any host.  Turn this on only if you want that trade.
# STORE_MODEL_IN_DB=True

# ---- almanac-office: a hosted model for the front office ---------------------
# Optional.  Uncomment the almanac-office block in litellm/config.yaml, set
# these three, redeploy, then AGENT_MODEL=almanac-office + `just agents-seed`.
#
# The guide agents' job — regurgitate the attached docs, hold a boundary, call
# one or two constrained tools, never invent — is what the small hosted models
# are good at and what four local ones measurably could not do
# (docs/design-walls.md).  Cheap here: six agents, low volume, and the
# knowledge corpus is this repo's own public docs.
#
# OFFICE_MODEL is provider-prefixed.  Prefer the Azure AI Foundry shape
# (azure_ai/<deployment>) where you have it — LiteLLM reads the real rates off
# the endpoint, so the ledger gets TRUE pricing rather than a pinned table.
# The vendor's own API (openai/<id>) falls back to LiteLLM's cost map, which
# will not know a model newer than our pin: that meters at $0, and $0 is an
# absence, not an error.  Verify a real spend row lands before you trust it.
# OFFICE_MODEL=azure_ai/gpt-5.6-luna
# OFFICE_BASE_URL=https://<your-foundry-resource>.services.ai.azure.com/models
# OFFICE_API_KEY=

# ---- OIDC: LibreChat -> Keycloak ---------------------------------------------
# The host in OPENID_ISSUER must match how the BROWSER reaches Keycloak:
#   direct ports:  http://<ALMANAC_HOST>:8080/realms/classroom
#                  (off-box, this needs PUBLISH_BIND=0.0.0.0 — see the top)
#   edge profile:  https://<AUTH_HOST>/realms/classroom
# In the edge profile AUTH_HOST is a BARE hostname and KC_HOSTNAME is exactly
# https://$AUTH_HOST: the edge aliases AUTH_HOST on the compose network, and
# that alias is how every LibreChat performs discovery.  Mixing the two shapes
# (a :8443 AUTH_HOST beside a hostname KC_HOSTNAME) misses the alias, and the
# instance boots anyway with SSO silently dead — see docs/tls.md.
# OPENID_CLIENT_SECRET: paste the secret Keycloak generates for the `librechat`
# client on first boot (admin -> Clients -> librechat -> Credentials).
OPENID_ISSUER=http://localhost:8080/realms/classroom
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=paste-from-keycloak-after-first-boot
OPENID_SESSION_SECRET=change-me-openid-session
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL="Sign in with Campus SSO"
# The FLAGSHIP's ADMIN mapping.  Whoever carries the `faculty` realm role is
# ADMIN at the front door — which means the vestibule's admin panel (:3082).
# Give it to operators only.  Instructors don't need it: each course renders
# its own mapping to that course's client roles, which the registrar sets
# from `instructors:`/`tas:` in courses.yaml (docs/admin-guide.md, "Roles:
# who is an instructor").  The bundled demo realm still assigns it to
# prof.vex; that is demo data, not the model.
OPENID_ADMIN_ROLE=faculty
OPENID_ADMIN_ROLE_PARAMETER_PATH=realm_access.roles
OPENID_ADMIN_ROLE_TOKEN_KIND=access

# ---- LibreChat admin panel (local groups, roles, config overrides) -----------
# Where course/team groups for agent sharing actually live — see the admin
# guide.  Faculty sign in with the same SSO button.  Min 32 chars; `just
# setup` generates it:
ADMIN_PANEL_SESSION_SECRET=change-me-admin-panel-session

# The admin-session cookie carries the `Secure` attribute.  True is both our
# default and the image's own, and it applies to every course's panel as well
# as the flagship's.  Flip it to false ONLY when a browser reaches a panel
# over http:// at a NON-LOCALHOST address — the browser drops the cookie,
# takes the PKCE verifier with it, and SSO dies at the callback with "SSO
# session state was lost before the callback".  The admin guide's `ssh -L`
# tunnel is not that shape: http://localhost counts as a trustworthy origin
# and keeps the cookie.  Through the edge it is always HTTPS.  So this only
# comes up with PUBLISH_BIND=0.0.0.0 and a browser pointed at the box's IP:
ADMIN_PANEL_SESSION_COOKIE_SECURE=true

# ---- Usage stats in chat (usage-mcp) -------------------------------------------
# "How much have I used?" answered by chat tools instead of a dashboard login.
# The token is how LibreChat proves itself to the service (it rides the
# mcpServers headers in librechat.yaml); the password is for usage_ro, the
# SELECT-only ledger role `just up` provisions.  `just setup` generates both.
# Course scoping lives in usage-mcp/roster.yaml — see the admin guide.
USAGE_MCP_TOKEN=change-me-usage-token
USAGE_DB_PASSWORD=change-me-usage-db

# ---- The course fleet: registrar + escrow (docs/registrar-spec.md) -------------
# Rosters and keys as chat tools: instructors paste class lists, students ask
# my_key.  Courses live in registrar/courses.yaml; `just course` provisions
# one LibreChat instance per course at <slug>.<ALMANAC_DOMAIN>.
REGISTRAR_MCP_TOKEN=change-me-registrar-token

# Bearer token the infosec scanner presents to fetch the live SBOM at
# https://<CHAT_HOST>/sbom/ (index.json + SPDX/CycloneDX per image, rewritten
# by every `just build`).  `just setup` generates it; hand it to the scanner
# once, with the URL, and never email an SBOM again.  See docs/ci.md.
SBOM_TOKEN=change-me-sbom-token
REGISTRAR_PORT=8091
# Default gateway aliases granted to newly created courses. Sites with more
# than one model can set a comma-separated list without forking the registrar.
REGISTRAR_BASE_MODELS=almanac-chat
# User-facing provider name and MCP server prefix in rendered course configs.
# These are presentation settings; internal container/data names do not change.
MODEL_PROVIDER_NAME=Almanac
MCP_SERVER_PREFIX=almanac

# What students and faculty call this platform.  Reader-facing pages, the
# guides' knowledge and prompts, and the help site all say {{PLATFORM}} in the
# source, and this fills it at `just docs-build` / `docs-corpus` / agent seed
# time.  Nothing in apex/ may name the platform outright — docs-corpus refuses.
# A fresh box should also set MODEL_PROVIDER_NAME and MCP_SERVER_PREFIX above
# (the picker's endpoint label and the tool-server names).  On a box with
# history, leave those two alone: old conversations remember the endpoint name.
PLATFORM_NAME=aLLManac

# Public documentation built from apex/ (the same Markdown used as the RAG
# corpus).  DOCS_SITE_NAME is the site's title; unset, it uses PLATFORM_NAME.
# DOCS_PRODUCT_NAME is the older spelling of PLATFORM_NAME and still works.
DOCS_SITE_NAME="The aLLManac"
DOCS_SITE_URL=http://localhost/help/
DOCS_PRODUCT_NAME=
# The fleet's domain: wildcard DNS points *.<ALMANAC_DOMAIN> at this box and
# one wildcard cert (DNS-01) covers every course.  Local dev needs neither —
# engr301-2026fall.localhost resolves to loopback all by itself.
ALMANAC_DOMAIN=localhost
# FLEET IDENTITY SHAPE (required for course instances; rig-verified): the
# instances discover Keycloak at https://<AUTH_HOST> THROUGH the edge, so
# Keycloak must advertise that exact issuer and LibreChat's Node must trust
# the edge's CA (internal-CA deployments).  Set all four together:
#   COMPOSE_PROFILES=edge
#   KC_HOSTNAME=https://auth.localhost          (or https://auth.<your-domain>)
#   KC_PROXY_HEADERS=xforwarded
#   OPENID_ISSUER=https://auth.localhost/realms/classroom
#   NODE_EXTRA_CA_CERTS=/caddy-data/caddy/pki/authorities/local/root.crt
#     (drop NODE_EXTRA_CA_CERTS when EDGE_TLS is real ACME)
# OpenBao (the escrow): 127.0.0.1 CLI bind; raft storage for online snapshots.
BAO_PORT=8200
OPENBAO_IMAGE=openbao/openbao:2.4.1
# Written by `just bao-init` (the once-per-box ritual) — not by hand:
# BAO_UNSEAL_KEY=            unseals after restarts (just up runs bao-unseal)
# BAO_REGISTRAR_ROLE_ID=     the registrar's AppRole
# BAO_REGISTRAR_SECRET_ID=
# Renders run as this uid:gid so fleet files land repo-owned (default 1000):
# REGISTRAR_UID=1000
# REGISTRAR_GID=1000
# Notifications — who hears that a room request or problem report moved.
# All optional.  With no SMTP_HOST, every message is appended to
# registrar/outbox.log on the host instead, and nothing leaves the box.
#   Campus relay that trusts this box's IP (no auth):
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=25
# SMTP_FROM=aLLManac <almanac@example.edu>   a From your relay will accept
#   Authenticated relay — set SMTP_USER and TLS defaults to starttls:
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=none|starttls|ssl                 (ssl = implicit TLS, port 465)
#   The admins' channel.  A Teams Workflows "when a webhook request is
#   received" URL, or anything taking {"text": ...} with FORMAT=text.  The URL
#   is a credential.  Without one, new requests are emailed to `admins:`.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_FORMAT=teams|text
# Budget rails — the three layers (decided 2026-07-22; see the spec):
# REGISTRAR_DEFAULT_COURSE_BUDGET=1000    the per-term pool (hard, per course)
# REGISTRAR_DEFAULT_FUSE=5                per-key ceiling (leak blast radius)
# REGISTRAR_MAX_FUSE=25                   server-side clamp on the fuse
# REGISTRAR_EXPORT_DAYS=14                days between course-close and archive
# REGISTRAR_DEFAULT_CONTEXT_TOKENS=128000 how big one conversation may get.
#   A COST cap, not a capability claim: it bounds what a single conversation
#   can spend on a metered model.  It is NOT a safe ceiling for a small
#   self-hosted model — LOWER it here, or set `context_tokens:` on the course,
#   if your endpoint serves less.  Too small trims a conversation early; too
#   large is the quiet one: some backends refuse it, but Ollama drops the
#   FRONT of the prompt — the agent's own instructions — and answers anyway,
#   with nothing in any log.  Set it from what the endpoint SERVES
#   (`/api/ps`), not what the model supports.  Changing it makes every
#   rendered course stale: run `just render`.
# REGISTRAR_MIN_FUSE=1                    refuse to mint below this — a key
#                                         that can't fund a session reads as
#                                         broken.  PLACEHOLDER: measure what a
#                                         real session costs and set it from
#                                         the ledger, not from taste.

# ---- Keycloak ------------------------------------------------------------------
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-kc-admin
KC_DB_PASSWORD=change-me-kc-db
KC_REALM=classroom
# Behind the edge profile, set the public hostname KC should advertise:
# KC_HOSTNAME=auth.almanac.example.edu
# KC_HOSTNAME_PORT=443

# ---- Edge front door (profile edge only) --------------------------------------
# One hostname per surface; Caddy terminates TLS for all three.
CHAT_HOST=chat.localhost
AUTH_HOST=auth.localhost
GATEWAY_HOST=gateway.localhost
# TLS mode: "internal" = Caddy's own local CA (LAN default, browsers will warn)
#           your@email  = real ACME (needs public reachability, or the DNS-01
#                         azure block in caddy/Caddyfile — see README)
EDGE_TLS=internal
ACME_EMAIL=ops@example.edu
# DNS-01 via delegated Azure zone (only if enabled in caddy/Caddyfile):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# Behind the edge, LibreChat should know its public URL:
# DOMAIN_CLIENT=https://chat.almanac.example.edu
# DOMAIN_SERVER=https://chat.almanac.example.edu

# ---- LAN HTTPS (edge profile, no DNS needed) -----------------------------------
# LibreChat (>= v0.8) requires an HTTPS OIDC issuer — plain http:// logins fail
# with "[openidStrategy] only requests to HTTPS are allowed".  On a LAN with no
# DNS, let the edge's internal CA mint IP certificates instead:
# (Have a LAN DNS name?  Use it in place of <box-ip> everywhere below —
# browsers then get a proper hostname cert.  Same internal CA either way.)
#
#   COMPOSE_PROFILES=edge
#   PUBLISH_BIND=0.0.0.0               # only if you also want the direct ports
#   ADMIN_PANEL_SESSION_COOKIE_SECURE=false   # only if a panel is reached over HTTP
#   CHAT_HOST=<box-ip>                 # chat on https://<box-ip>
#   AUTH_HOST=<box-ip>:8443            # keycloak on https://<box-ip>:8443
#   EDGE_DEFAULT_SNI=<box-ip>          # IP clients send no SNI; this picks the cert
#   OPENID_ISSUER=https://<box-ip>:8443/realms/classroom
#   KC_HOSTNAME=https://<box-ip>:8443
#   KC_PROXY_HEADERS=xforwarded
#   DOMAIN_CLIENT=https://<box-ip>
#   DOMAIN_SERVER=https://<box-ip>
#   # Node inside librechat must trust Caddy's internal CA (mounted read-only):
#   NODE_EXTRA_CA_CERTS=/caddy-data/caddy/pki/authorities/local/root.crt
#
# Browsers warn once on the internal CA — accepted posture for LAN/dev.  For
# real certs, use hostnames + real ACME (EDGE_TLS=you@email / DNS-01).
