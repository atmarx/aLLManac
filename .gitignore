# Real credentials — never in git
.env

# The live roster (student emails = deployment data, not code).  The example
# ships in git; first `just up` copies it into place.  It is now a RENDER —
# the registrar rewrites it from registrar/courses.yaml.
usage-mcp/roster.yaml

# The registrar's course records (real rosters = student emails) and the
# whole rendered fleet (instance secrets live in fleet/*.env).  Stubs are
# seeded by `just _fleet`; everything here is regenerable from courses.yaml.
registrar/courses.yaml
registrar/nominations.yaml
fleet/

# This deployment's own compose layer, its optional inference stack, and
# whatever brings up the metal underneath it.  Cloned from site.example/ by
# `just _site` and owned by the box from then on — one deployment's site/ is
# nobody else's business, which is exactly why it isn't in git.
site/

# Static documentation output (just docs-build). The Markdown source in apex/
# is tracked; the generated HTML is rebuilt on each deployment.
site-dist/

# SBOM artifacts — rewritten by every `just build` (sbom/latest/, served by
# the edge at /sbom/) plus dated tarballs in sbom/archive/.  A render of the
# images on the box; too big and too derivative for git
sbom/

# Agent worktrees (fleet sessions branch here; the branches are the record)
.worktrees/

# Editor / OS noise
.DS_Store
*.swp

# Python bytecode (py_compile checks, container mounts)
__pycache__/
*.pyc

# The per-audience RAG corpora.  A RENDER of the docs tree via front matter
# (`just docs-corpus`) — one source, N projections, no second copy to drift.
corpus/

# Problem reports (quotes people, names their course).
registrar/reports.yaml

# Environment requests (names people) and this deployment's front-door
# wording (front-door.example.md is the tracked default).
registrar/requests.yaml
registrar/front-door.md
# Notification mail when no SMTP server is set (names people).
registrar/outbox.log
# Owner exports — one person's conversations each, 24h, 0600 (registrar/planes/exports.py)
registrar/exports/
