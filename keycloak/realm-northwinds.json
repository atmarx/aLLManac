  "clients": [
    {
      "clientId": "librechat",
      "name": "LibreChat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3080/oauth/openid/callback",
        "http://*:3080/oauth/openid/callback"
      ],
      "webOrigins": ["+"],
      "attributes": { "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "globus",
      "displayName": "Globus",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "clientId": "",
        "clientSecret": "",
        "issuer": "https://auth.globus.org",
        "authorizationUrl": "https://auth.globus.org/v2/oauth2/authorize",
        "tokenUrl": "https://auth.globus.org/v2/oauth2/token",
        "userInfoUrl": "https://auth.globus.org/v2/oauth2/userinfo",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "jwksUrl": "https://auth.globus.org/jwk.json",
        "syncMode": "IMPORT"
      }
    }
  ]
}
